# Copier ce fichier en deploy.env (jamais commité) puis remplir avec les accès o2switch.
# Aucun mot de passe ici : la base est lue dans le .env.local du serveur.

# Connexion SSH (utilisateur@serveur), clé SSH déjà installée
SSH_HOST="utilisateur@serveur.o2switch.net"

# Dossier du site sur le serveur (contiendra releases/, shared/, dumps/, current)
REMOTE_DIR="/home/utilisateur/seydeco"

# PHP 8.4 en ligne de commande (chemin à confirmer sur o2switch)
PHP_BIN="/opt/alt/php84/usr/bin/php"

# Composer sur le serveur (fichier .phar lancé avec PHP_BIN)
COMPOSER_PHAR="/home/utilisateur/composer.phar"

# Branche déployée (le commit doit être poussé et sa CI verte)
BRANCH="main"

# Nombre de releases (et de dumps) conservées, 2 minimum pour le retour arrière
KEEP_RELEASES=3
