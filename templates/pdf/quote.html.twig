{# Devis PDF (story 3.13, FR-7) rendu par PdfRenderer : tout est lu dans la version figée (AD-8), montants par le filtre `money`.
   Aucune coordonnée bancaire. Police DejaVu (seule police embarquée), aucune ressource distante. #}
{% import 'quote/_period.html.twig' as period %}
{% set context = version.pricingContext %}
{% set c = context.conditions ?? {} %}
{% set seller = context.seller ?? site_contact() %}
{% set bp = context.depositBasisPoints ?? 0 %}
{% set percent = (bp / 100)|number_format(bp % 100 ? 2 : 0, ',', ' ') %}
{% set damage = version.lines.toArray|filter(l => l.breakagePrice is not null or l.lossPrice is not null) %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Devis {{ quote.number }}</title>
    <style>
        @page { margin: 14mm 14mm 16mm; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 9pt; color: #1F1D1A; line-height: 1.35; }
        h1 { font-size: 16pt; font-weight: normal; margin: 0 0 2mm; }
        h2 { font-size: 10pt; text-transform: uppercase; letter-spacing: 0.08em; margin: 6mm 0 2mm; border-bottom: 1px solid #1F1D1A; padding-bottom: 1mm; }
        p { margin: 0 0 1.5mm; }
        .head { width: 100%; border-collapse: collapse; }
        .head td { vertical-align: top; width: 50%; }
        .brand { font-size: 14pt; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1mm; }
        .right { text-align: right; }
        .caps { text-transform: uppercase; letter-spacing: 0.08em; font-weight: bold; }
        .muted { color: #5E5850; }
        dl { margin: 0; }
        dt { float: left; width: 38mm; clear: left; color: #5E5850; }
        dd { margin: 0 0 1mm 40mm; }
        .lines { width: 100%; border-collapse: collapse; }
        .lines th { text-align: left; font-weight: bold; border-bottom: 1px solid #1F1D1A; padding: 1.5mm 1mm; }
        .lines td { border-bottom: 0.5px solid #C9C2B8; padding: 1.5mm 1mm; vertical-align: middle; }
        .lines .num { text-align: right; white-space: nowrap; }
        .thumb { width: 12mm; height: 12mm; border: 0.5px solid #C9C2B8; }
        .thumb img { width: 12mm; height: 12mm; }
        .totals { width: 80mm; margin: 3mm 0 0 auto; border-collapse: collapse; page-break-inside: avoid; }
        .totals td { padding: 1mm; }
        .totals .num { text-align: right; white-space: nowrap; }
        .totals .total td { font-size: 11pt; font-weight: bold; border-top: 1px solid #1F1D1A; }
        ul { margin: 0; padding-left: 4mm; }
        li { margin-bottom: 1mm; }
        .sign { margin-top: 6mm; border: 1px solid #1F1D1A; height: 28mm; padding: 2mm; width: 80mm; }
    </style>
</head>
<body>
    <table class="head">
        <tr>
            <td>
                <p class="brand">Seydeco</p>
                {% if seller.address %}<p>{{ seller.address|nl2br }}</p>{% endif %}
                {% if seller.phone %}<p>Tél. {{ seller.phone }}</p>{% endif %}
                {% if seller.email %}<p>{{ seller.email }}</p>{% endif %}
                {% if seller.siret %}<p>SIRET {{ seller.siret }}</p>{% endif %}
            </td>
            <td class="right">
                <h1>Devis {{ quote.number }}</h1>
                <p>Du {{ quote.createdAt|date('d/m/Y') }}</p>
                <p class="caps">Sous réserve de disponibilité</p>
            </td>
        </tr>
    </table>

    <h2>Cliente</h2>
    <dl>
        <dt>Nom</dt><dd>{{ quote.firstName }} {{ quote.lastName }}</dd>
        <dt>Téléphone</dt><dd>{{ quote.phone }}</dd>
        <dt>Email</dt><dd>{{ quote.email }}</dd>
        {% if quote.companyName %}<dt>Raison sociale</dt><dd>{{ quote.companyName }}</dd>{% endif %}
        {% if quote.siret %}<dt>SIRET</dt><dd>{{ quote.siret }}</dd>{% endif %}
        {% if quote.billingAddress %}<dt>Adresse de facturation</dt><dd>{{ quote.billingAddress }}</dd>{% endif %}
    </dl>

    <h2>Événement</h2>
    <dl>
        <dt>Date</dt><dd>{{ version.eventDate|date('d/m/Y') }}</dd>
        {{ period.rows(version) }}
    </dl>

    <h2>Détail</h2>
    <table class="lines">
        <thead>
            <tr><th colspan="2">Désignation</th><th class="num">Quantité</th><th class="num">Prix unitaire</th><th class="num">Montant</th></tr>
        </thead>
        <tbody>
            {% for line in version.lines %}
                {% set product = line.type.value == 'product' %}
                <tr>
                    <td style="width: 13mm;">
                        {% if product %}
                            {% set photos = line.product ? line.product.photos.toArray : [] %}
                            {% set photo = (photos|filter(p => p.color and p.color.name == line.colorName)|first) ?: photos|first %}
                            {% set thumb = pdf_thumbnail(photo ? photo.filename : null) %}
                            <div class="thumb">{% if thumb %}<img src="{{ thumb }}" alt="">{% endif %}</div>
                        {% endif %}
                    </td>
                    <td>
                        {{ line.label }}{% if line.colorName %}<br><span class="muted">{{ line.colorName }}</span>{% endif %}
                        {% if line.type.value in ['delivery', 'pickup'] and line.amount and context.km %}<br><span class="muted">{{ context.km }} km, {{ context.trips }} voyage{{ context.trips > 1 ? 's' }}</span>{% endif %}
                    </td>
                    <td class="num">{{ line.quantity }}</td>
                    <td class="num">{{ line.unitPrice is not null ? line.unitPrice|money }}</td>
                    {# Livraison à confirmer, installation sur demande : le libellé le dit, pas de « 0,00 € » #}
                    <td class="num">{{ product or line.amount ? line.amount|money }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% if version.delivery %}<p class="muted">Péages éventuels ajoutés par Serife.</p>{% endif %}

    <table class="totals">
        <tr class="total"><td>Total{{ version.excludesDelivery ? ' hors livraison' }}</td><td class="num">{{ version.total|money }}</td></tr>
        <tr><td>Acompte {{ percent }} %</td><td class="num">{{ version.deposit|money }}</td></tr>
        <tr><td>Reste à payer</td><td class="num">{{ (version.total - version.deposit)|money }}</td></tr>
        {% if context.depositAmount is not null %}<tr><td>Caution</td><td class="num">{{ context.depositAmount|money }}</td></tr>{% endif %}
    </table>

    <h2>Conditions et consignes</h2>
    <ul>
        <li>Devis sous réserve de disponibilité : Serife vérifie la date et vous recontacte.</li>
        {% if bp %}<li>Acompte : {{ percent }} % du total, versé pour réserver. Il n'est pas remboursable.</li>{% endif %}
        <li>Caution : {% if context.depositAmount is not null %}{{ context.depositAmount|money(true) }}, par chèque{% else %}par chèque{% endif %}, avec présentation d'une pièce d'identité.</li>
        {% if (context.chairs ?? 0) > 0 and not version.cleaning %}<li>Les chaises sont rendues propres.</li>{% endif %}
        {% if c.returnTerms ?? '' %}<li>Retour : {{ c.returnTerms|nl2br }}</li>{% endif %}
        {% if not version.delivery and (c.pickupTerms ?? '') %}<li>Retrait au dépôt : {{ c.pickupTerms|nl2br }}</li>{% endif %}
        {% if version.delivery and (c.fuelTerms ?? '') %}<li>Tarif de livraison : {{ c.fuelTerms|nl2br }}</li>{% endif %}
    </ul>

    {% if damage %}
        <h2>Casse ou perte</h2>
        <ul>
            {% for line in damage %}
                <li>{{ line.label }} :
                    {{- line.breakagePrice is not null ? ' casse ' ~ line.breakagePrice|money ~ ' par unité' }}
                    {{- line.breakagePrice is not null and line.lossPrice is not null ? ',' }}
                    {{- line.lossPrice is not null ? ' perte ' ~ line.lossPrice|money ~ ' par unité' }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2>Paiement</h2>
    <p>Moyens acceptés : {{ (c.paymentMethods ?? [])|join(', ') ?: 'à voir avec Serife' }}. Pas de paiement en ligne.</p>

    <div class="sign">Bon pour accord, date et signature</div>
</body>
</html>
