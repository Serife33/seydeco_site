{# Carte réalisation (UX-DR41) : photo pleine (4:5 sur mobile, 380 px de haut sur desktop), titre label-caps, lieu et ville en ink-muted #}
{% set photo = realisation.photos|first %}
{% set tag = tag|default('h2') %}
<li class="product-card realisation-card">
    <div class="product-card__media">
        {% if photo %}
            <img src="{{ photo.filename|imagine_filter('catalog_card') }}" width="480" height="600" alt="{{ photo.alt }}"{% if lazy|default(false) %} loading="lazy"{% endif %} decoding="async">
        {% endif %}
    </div>
    {# Lien étiré sur toute la carte #}
    <{{ tag }} class="product-card__name"><a href="{{ path('realisation_show', {slug: realisation.slug}) }}">{{ realisation.title }}</a></{{ tag }}>
    <p class="product-card__price">{{ realisation.venueName }}, {{ realisation.city }}</p>
</li>
