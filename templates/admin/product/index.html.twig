{% extends 'admin/base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
    <div class="admin-head">
        <h1 class="admin-title">Produits</h1>
        <a class="admin-button" href="{{ path('admin_product_new') }}">Ajouter un produit</a>
    </div>
    {{ include('admin/_flashes.html.twig') }}
    {% for key in app.flashes('draft_saved') %}
        <div hidden data-controller="form-draft" data-form-draft-key-value="seydeco.draft.product.{{ key }}" data-form-draft-clear-value="true"></div>
    {% endfor %}

    <form method="get" class="admin-filters" role="search">
        <div class="admin-field">
            <label for="q">Rechercher</label>
            <input type="search" id="q" name="q" value="{{ query }}">
        </div>
        <div class="admin-field">
            <label for="categorie">Catégorie</label>
            <select id="categorie" name="categorie">
                <option value="">Toutes</option>
                {% for c in categories %}
                    <option value="{{ c.id }}"{% if category and category.id == c.id %} selected{% endif %}>{{ c.name }}</option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="admin-button admin-button--secondary">Filtrer</button>
    </form>

    {% if products|length == 0 %}
        <p>Aucun produit.</p>
    {% else %}
        <ul class="admin-list">
            {% for product in products %}
                <li class="admin-list__row">
                    <a class="admin-list__main" href="{{ path('admin_product_edit', {id: product.id}) }}">
                        <span class="admin-thumb" aria-hidden="true"></span>
                        <span>
                            <span class="admin-list__name">{{ product.name }}</span>
                            <span class="admin-list__meta">{{ product.category.name }} · stock {{ product.stock }}{% if not product.visible %} · <strong>Masqué</strong>{% endif %}</span>
                        </span>
                    </a>
                    <form class="admin-list__actions" method="post" action="{{ path('admin_product_toggle', app.request.query.all|merge({id: product.id})) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('product' ~ product.id) }}">
                        {% set action = product.visible ? 'Masquer' : 'Afficher à nouveau' %}
                        <button class="admin-button admin-button--secondary admin-button--small" aria-label="{{ action }} {{ product.name }}">{{ action }}</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        {{ include('admin/_pagination.html.twig') }}
    {% endif %}
{% endblock %}
