{% use 'form_div_layout.html.twig' %}
{% use 'form_div_layout.html.twig' with money_widget as base_money_widget %}

{%- block money_widget -%}
    <span class="admin-money">{{- block('base_money_widget') -}}</span>
{%- endblock money_widget -%}

{# Registre Atelier : erreurs sous le champ ; aria-invalid / aria-describedby viennent de form_row #}
{%- block form_row_render -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' admin-field')|trim}) -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row_render -%}

{%- block form_errors -%}
    {%- for error in errors -%}
        <p class="admin-field__error" id="{{ id ~ '_error' ~ loop.index }}"{% if form is rootform %} role="alert"{% endif %}>{{ error.message }}</p>
    {%- endfor -%}
{%- endblock form_errors -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="admin-field__help">{{ help }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block checkbox_row -%}
    {%- set widget_attr = {attr: errors|length > 0 ? {'aria-invalid': 'true'} : {}} -%}
    <div class="admin-field admin-field--check">
        {{- form_widget(form, widget_attr) -}}
        {{- form_label(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="admin-checks">
        {%- for child in form %}
            <div class="admin-field--check">
                {{- form_widget(child) -}}
                {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
            </div>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block _product_styles_row -%}{{ block('fieldset_row') }}{%- endblock -%}
{%- block _product_eventTypes_row -%}{{ block('fieldset_row') }}{%- endblock -%}

{# Liste de cases : un fieldset/legend plutôt qu'un label sans cible #}
{%- block fieldset_row -%}
    <fieldset class="admin-field admin-fieldset">
        <legend>{{ label }}</legend>
        {%- if form.children is empty -%}
            <p class="admin-field__help">Aucun pour l'instant : en ajouter ci-dessous.</p>
        {%- endif -%}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
    </fieldset>
{%- endblock fieldset_row -%}

{# Texte mis en forme simple : barre de boutons au-dessus de la zone de texte (contrôleur markdown-toolbar) #}
{%- block markdown_widget -%}
    <div class="admin-markdown" data-controller="markdown-toolbar">
        <div class="admin-markdown__bar" role="toolbar" aria-label="Mise en forme" aria-controls="{{ id }}">
            <button type="button" class="admin-button admin-button--secondary admin-button--small" data-action="markdown-toolbar#heading">Titre</button>
            <button type="button" class="admin-button admin-button--secondary admin-button--small" data-action="markdown-toolbar#bold">Gras</button>
            <button type="button" class="admin-button admin-button--secondary admin-button--small" data-action="markdown-toolbar#list">Liste</button>
            <button type="button" class="admin-button admin-button--secondary admin-button--small" data-action="markdown-toolbar#link">Lien</button>
        </div>
        {%- set attr = attr|merge({'data-markdown-toolbar-target': 'input'}) -%}
        {{- block('textarea_widget') -}}
    </div>
{%- endblock markdown_widget -%}
