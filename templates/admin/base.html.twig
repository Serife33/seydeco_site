<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}Back-office{% endblock %} — Seydeco</title>
        <link rel="preload" href="{{ asset('fonts/jost-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block javascripts %}{{ importmap('app') }}{% endblock %}
        <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    </head>
    <body class="admin" data-controller="heic">
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        {% block layout %}
            <div class="admin-shell">
                <nav class="admin-nav" aria-label="Navigation du back-office">
                    <p class="admin-nav__brand">Seydeco</p>
                    {% set current = app.request.attributes.get('_route')|default('') %}
                    <ul>
                        {% set new_requests = new_quote_requests() %}
                        <li><a href="{{ path('admin_dashboard') }}"{% if current == 'admin_dashboard' %} aria-current="page"{% endif %}>Accueil{% if new_requests %} <span class="admin-count">{{ new_requests }}<span class="visually-hidden"> nouvelle{{ new_requests > 1 ? 's' }} demande{{ new_requests > 1 ? 's' }}</span></span>{% endif %}</a></li>
                        <li><a href="{{ path('admin_more') }}"{% if current == 'admin_more' or current starts with 'admin_category' or current starts with 'admin_product' or current starts with 'admin_pack' or current starts with 'admin_page' or current starts with 'admin_faq' or current starts with 'admin_realisation' or current starts with 'admin_venue' or current starts with 'admin_announcement' or current starts with 'admin_review' or current starts with 'admin_home_hero' or current starts with 'admin_featured' or current starts with 'admin_quote_request' or current ends with '_settings' %} aria-current="page"{% endif %}>Plus</a></li>
                    </ul>
                </nav>
                <main id="contenu" class="admin-main" tabindex="-1">
                    {% block body %}{% endblock %}
                </main>
            </div>
        {% endblock %}
    </body>
</html>
