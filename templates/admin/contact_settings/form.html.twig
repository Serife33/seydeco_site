{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}Coordonnées et réseaux{% endblock %}

{% block body %}
    <p><a class="admin-link" href="{{ path('admin_more') }}">← Plus</a></p>
    <h1 class="admin-title">Coordonnées et réseaux</h1>
    {% include 'admin/_flashes.html.twig' %}
    <p class="admin-field__help">Affichés dans l'en-tête et le pied de page du site. Un champ laissé vide n'est affiché nulle part.</p>

    {{ form_start(form, {attr: {class: 'admin-form admin-form--sticky', novalidate: 'novalidate', 'data-controller': 'unsaved-changes'}}) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <div class="admin-form__save">
            <button type="submit" class="admin-button">Enregistrer</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
