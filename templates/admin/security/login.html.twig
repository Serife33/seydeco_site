{% extends 'admin/security/_layout.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <h1 class="admin-title">Connexion</h1>

    {% for message in app.flashes('error') %}
        <p class="admin-error" role="alert">{{ message }}</p>
    {% endfor %}
    {% if error %}
        <p class="admin-error" id="login-error" role="alert">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}" class="admin-form">
        <div class="admin-field">
            <label for="username">Adresse email</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus{% if error %} aria-invalid="true" aria-describedby="login-error"{% endif %}>
        </div>
        <div class="admin-field">
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required{% if error %} aria-invalid="true" aria-describedby="login-error"{% endif %}>
        </div>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="admin-button">Se connecter</button>
    </form>
{% endblock %}
