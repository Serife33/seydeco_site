{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} en location | Seydeco{% endblock %}
{% set description = category.name ~ ' à louer pour vos mariages et événements : ' ~ total ~ ' produit' ~ (total > 1 ? 's' : '') ~ ' à découvrir chez Seydeco, prix dégressifs selon la quantité.' %}
{% set og_image = products and (products|first).photos|first ? ((products|first).photos|first).filename|imagine_filter('product_800') : null %}

{% block body %}
    <div class="container catalog-page">
        {% include 'catalog/_breadcrumb.html.twig' with {items: [{label: 'Location', url: path('catalog_index')}, {label: category.name}]} only %}
        <h1>{{ category.name }}</h1>
        {% include 'catalog/_listing.html.twig' with {route: 'catalog_category', routeParams: {slug: category.slug}, clearUrl: path('catalog_category', {slug: category.slug})} %}
    </div>
{% endblock %}
