{% extends 'base.html.twig' %}

{% block title %}{{ pack.name }} n'est plus proposé | Seydeco{% endblock %}
{# Ancienne URL d'un élément masqué : page conservée, non indexée, sans JSON-LD produit (AD-23) #}
{% set noindex = true %}
{% set description = 'Ce pack « ' ~ pack.name ~ ' » n\'est plus proposé chez Seydeco. Découvrez le reste du catalogue de location.' %}

{% block body %}
    <div class="container catalog-page">
        {% include 'catalog/_breadcrumb.html.twig' with {items: [{label: 'Location', url: path('catalog_index')}, {label: pack.name}]} only %}
        <h1>{{ pack.name }}</h1>
        <p>Ce pack n'est plus proposé.</p>
        <p><a href="{{ path('catalog_index') }}">Voir le catalogue</a></p>
    </div>
{% endblock %}
