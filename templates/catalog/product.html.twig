{% extends 'base.html.twig' %}

{% set from = from_price(product) %}
{% set first = product.photos|first %}
{% block title %}{{ product.name }} — location{% if from is not null %} dès {{ from|money }}{% endif %} | Seydeco{% endblock %}
{% set description = product.description|trim ?: product.name ~ ' en location' ~ (from is not null ? ' dès ' ~ from|money : '') ~ ' chez Seydeco' ~ (product.dimensions ? ' (' ~ product.dimensions ~ ')' : '') ~ ', pour vos mariages et événements.' %}
{% set og_type = 'product' %}
{% set og_price = from %}
{% set og_image = first ? first.filename|imagine_filter('product_800') : null %}
{% set whatsapp_message = 'Bonjour, j\'ai une question sur ' ~ product.name %}
{% block structured_data %}{{ parent() }}{% include 'seo/product.html.twig' %}{% endblock %}

{% block body %}
    {% set photos = product.photos %}
    {% set colors = product.colors %}
    {% set first = photos|first %}
    <div class="container catalog-page">
        {% include 'catalog/_breadcrumb.html.twig' with {items: [{label: 'Location', url: path('catalog_index')}, {label: category.name, url: path('catalog_category', {slug: category.slug})}, {label: product.name}]} only %}

        <div class="product-page" data-controller="gallery color-picker" data-action="color-picker:change->gallery#filter">
            <div class="product-gallery">
                {% if first %}
                    {# Seule la photo principale est chargée tout de suite ; les autres à l'approche ou à l'ouverture #}
                    <a class="product-gallery__main" href="{{ first.filename|imagine_filter('product_full') }}" data-gallery-target="main" data-action="gallery#open">
                        <img src="{{ first.filename|imagine_filter('product_800') }}"
                             srcset="{{ first.filename|imagine_filter('product_400') }} 400w, {{ first.filename|imagine_filter('product_800') }} 800w"
                             sizes="(min-width: 1024px) 600px, 100vw" width="800" height="800" alt="{{ first.alt }}" fetchpriority="high">
                        <span class="visually-hidden">(agrandir)</span>
                    </a>
                    {# Lien de partage simple : aucun script Pinterest chargé (NFR-11) #}
                    <a class="pin-link" href="https://www.pinterest.com/pin/create/button/?{{ {url: canonical, media: og_image, description: description}|url_encode }}" target="_blank" rel="noopener">
                        {% include 'layout/_icon.html.twig' with {name: 'pinterest', size: 18} only %}Épingler<span class="visually-hidden"> sur Pinterest (nouvel onglet)</span>
                    </a>
                    {% if photos|length > 1 %}
                        <ul class="product-gallery__thumbs">
                            {% for photo in photos %}
                                <li data-gallery-target="item" data-color="{{ photo.color ? photo.color.id }}"
                                    data-src="{{ photo.filename|imagine_filter('product_800') }}"
                                    data-srcset="{{ photo.filename|imagine_filter('product_400') }} 400w, {{ photo.filename|imagine_filter('product_800') }} 800w"
                                    data-full="{{ photo.filename|imagine_filter('product_full') }}" data-alt="{{ photo.alt }}">
                                    <a class="product-gallery__thumb" href="{{ photo.filename|imagine_filter('product_full') }}" data-action="gallery#open"{% if loop.first %} aria-current="true"{% endif %}>
                                        <img src="{{ photo.filename|imagine_filter('product_thumb') }}" width="240" height="240" alt="{{ photo.alt }}" loading="lazy" decoding="async">
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% include 'catalog/_lightbox.html.twig' with {title: product.name} only %}
                {% else %}
                    <div class="product-gallery__empty"></div>
                {% endif %}

                {% if video %}
                    {% set poster = product.videoThumbnail ?? (first ? first.filename : null) %}
                    {% include 'catalog/_video.html.twig' with {video: video, poster: poster, title: product.name, src: path('catalog_product_video', {categorySlug: category.slug, slug: product.slug})} only %}
                {% endif %}
            </div>

            <div class="product-panel">
                <h1>{{ product.name }}</h1>
                {% include 'catalog/_price_tiers.html.twig' %}
                {% if category.pricingType.value == 'tables' and product.priceWithChairs and tiers %}
                    <p class="accent-sm product-panel__chairs">Avec vos chaises Seydeco : {{ product.priceWithChairs|money }} la table au lieu de {{ (tiers|first).price|money }} — dès que vous louez assez de chaises pour garnir toutes vos tables</p>
                {% elseif chairsNote %}
                    <p class="product-panel__chairs">Bon à savoir : les tables rondes sont moins chères louées avec les chaises.</p>
                {% endif %}
                {% if product.minQty > 1 %}
                    <p class="product-panel__min">Minimum {{ product.minQty }} {{ {chairs: 'chaises', tables: 'tables'}[category.pricingType.value] ?? 'unités' }}</p>
                {% endif %}
                {% if product.seats %}
                    <p class="product-panel__seats">{{ product.seats }} place{{ product.seats > 1 ? 's' }}</p>
                {% endif %}

                {% if colors|length %}
                    {# Le coloris choisi est mémorisé ici pour l'ajout au devis (story 1.13) #}
                    <div class="color-picker">
                        <p class="label-caps" id="coloris-titre">Coloris : <span data-color-picker-target="name">{{ colors.first.name }}</span></p>
                        <div class="color-picker__swatches" role="group" aria-labelledby="coloris-titre">
                            {% for color in colors %}
                                <button type="button" class="swatch" style="--swatch: {{ color.hex }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                                        data-color-picker-target="swatch" data-action="color-picker#choose"
                                        data-color-id="{{ color.id }}" data-color-name="{{ color.name }}"><span class="visually-hidden">{{ color.name }}</span></button>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% include 'catalog/_add_to_quote.html.twig' with {quantity: true, links: related} %}

                {% include 'catalog/_contact.html.twig' %}

                {% if product.dimensions or product.description %}
                    <section class="product-details">
                        {% if product.dimensions %}
                            <h2 class="label-caps">Dimensions</h2>
                            <p>{{ product.dimensions }}</p>
                        {% endif %}
                        {% if product.description %}
                            <h2 class="label-caps">Description</h2>
                            <p>{{ product.description|nl2br }}</p>
                        {% endif %}
                    </section>
                {% endif %}

                {% include 'catalog/_practical_info.html.twig' %}
            </div>
        </div>

        {% if related %}
            {# Après le Bloc infos pratiques, dans la page (jamais en popup) ; associés masqués déjà écartés #}
            <section class="related" aria-labelledby="souvent-loue-avec">
                <h2 class="accent-sm related__title" id="souvent-loue-avec">Souvent loué avec</h2>
                <ul class="product-grid product-grid--related">
                    {% for product in related %}
                        {% include 'catalog/_product_card.html.twig' with {lazy: true, tag: 'h3', relatedLinks: {}} %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
{% endblock %}
