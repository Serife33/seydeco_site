{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} n'est plus proposé | Seydeco{% endblock %}
{# Ancienne URL d'un élément masqué : page conservée, non indexée, sans JSON-LD produit (AD-23) #}
{% set noindex = true %}
{% set description = 'Ce produit « ' ~ product.name ~ ' » n\'est plus proposé chez Seydeco. Découvrez le reste du catalogue de location.' %}

{% block body %}
    {% set category = product.category %}
    <div class="container catalog-page">
        {% include 'catalog/_breadcrumb.html.twig' with {items: [{label: 'Location', url: path('catalog_index')}, {label: category.name, url: path('catalog_category', {slug: category.slug})}, {label: product.name}]} only %}
        <h1>{{ product.name }}</h1>
        <p>Ce produit n'est plus proposé.</p>
        {% if products|length %}
            <h2>Dans la même catégorie</h2>
            <ul class="product-grid">
                {% for product in products %}
                    {% include 'catalog/_product_card.html.twig' with {lazy: loop.index > 4} %}
                {% endfor %}
            </ul>
        {% else %}
            <p><a href="{{ path('catalog_index') }}">Voir le catalogue</a></p>
        {% endif %}
    </div>
{% endblock %}
