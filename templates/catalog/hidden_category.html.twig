{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} n'est plus proposée | Seydeco{% endblock %}
{# Ancienne URL d'un élément masqué : page conservée, non indexée, sans JSON-LD produit (AD-23) #}
{% set noindex = true %}
{% set description = 'Cette catégorie « ' ~ category.name ~ ' » n\'est plus proposée chez Seydeco. Découvrez le reste du catalogue de location.' %}

{% block body %}
    <div class="container catalog-page">
        {% include 'catalog/_breadcrumb.html.twig' with {items: [{label: 'Location', url: path('catalog_index')}, {label: category.name}]} only %}
        <h1>{{ category.name }}</h1>
        <p>Cette catégorie n'est plus proposée.</p>
        <p><a href="{{ path('catalog_index') }}">Voir le catalogue</a></p>
    </div>
{% endblock %}
