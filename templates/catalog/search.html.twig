{% extends 'base.html.twig' %}

{% block title %}Recherche{% if filters.q %} « {{ filters.q }} »{% endif %} | Seydeco{% endblock %}
{% set description = (filters.q ? 'Résultats pour « ' ~ filters.q ~ ' »' : 'Recherche') ~ ' dans le catalogue de location Seydeco : ' ~ total ~ ' produit' ~ (total > 1 ? 's' : '') ~ '.' %}
{# Seule la recherche garde un paramètre dans son adresse canonique : les filtres et pages n'en ont pas #}
{% set canonical = url('catalog_search', filters.q ? {q: filters.q} : {}) %}
{# Résultats de recherche hors index : adresses en nombre illimité #}
{% set noindex = true %}
{% block search_value %}{{ filters.q }}{% endblock %}

{% block body %}
    <div class="container catalog-page">
        {% include 'catalog/_breadcrumb.html.twig' with {items: [{label: 'Location', url: path('catalog_index')}, {label: 'Recherche'}]} only %}
        <h1>{% if filters.q %}Résultats pour « {{ filters.q }} »{% else %}Recherche{% endif %}</h1>
        {% include 'catalog/_listing.html.twig' with {route: 'catalog_search', routeParams: {}, clearUrl: path('catalog_search', filters.q ? {q: filters.q} : {})} %}
    </div>
{% endblock %}
